daemon-ia/Audios bons/*
!daemon-ia/Audios bons/.gitkeep

daemon-ia/_backup_npc/

# Arquivos de saída de testes antigos
daemon-ia/saida_*.wav

# Logs e Temporários
*.log
*.tmp
*.tmp.wav
daemon-ia/teste.txt

# Segredos / Variáveis de Ambiente
.env
*.key

